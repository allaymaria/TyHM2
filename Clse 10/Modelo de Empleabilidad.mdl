{UTF-8}
DESIRED INVENTORY=20000
	~	widgets
	~		|

Employment= INTEG (Net change in employment,
		INITIAL EMPLOYMENT)
	~	people
	~		|

Gap=DESIRED INVENTORY-Inventory
	~	widgets
	~		|

HIRING DELAY=0.25
	~	Year
	~		|

INITIAL EMPLOYMENT=200
	~	people
	~		|

INITIAL INVENTORY=20000
	~	widgets
	~		|

Inventory= INTEG (Production less sales,
		INITIAL INVENTORY)
	~	widgets
	~		|

Net change in employment=Number of people needed for hire/HIRING DELAY
	~	people/Year
	~		|

Number of people needed for hire=Production needed to close gap/PRODUCTIVITY
	~	people
	~		|

Production less sales=(Employment*PRODUCTIVITY)-SALES
	~	widgets/Year
	~		|

Production needed to close gap=Gap/TIME TO CLOSE INVENTORY GAP
	~	widgets/Year
	~		|

PRODUCTIVITY=100
	~	widgets/(people*Year)
	~		|

SALES=20000
	~	widgets/Year
	~		|

TIME TO CLOSE INVENTORY GAP=0.5
	~	Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 10
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Year [0,?]
	~	The time step for the simulation.
	|

